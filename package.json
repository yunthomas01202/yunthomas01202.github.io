{
  "name": "ultimate-study",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build -p android --profile preview",
    "build:ios": "eas build -p ios --profile preview",
    "web": "node scripts/run-web.cjs",
    "build:web": "node scripts/build-pages.cjs",
    "build:pages": "node scripts/build-pages.cjs",
    "test:pages": "node --test scripts/pages.test.cjs",
    "preview:pages": "node scripts/preview-pages.cjs"
  },
  "dependencies": {
