    "@react-native-firebase/auth": "^23.4.0",
    "@react-native-firebase/firestore": "^23.4.0",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.0",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.0",
    "expo-clipboard": "~8.0.0",
