{
  "expo": {
    "name": "학습지원",
    "slug": "ultimate-study",
    "scheme": "ultimatestudy",
    "version": "1.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.thiomasas.ultimatestudy",
      "supportsTablet": true,
      "requireFullScreen": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.thiomasas.ultimatestudy",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#1F1760",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "YOUR_APPLE_TEAM_ID",
          "appGroup": "group.com.thiomasas.ultimatestudy"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "googleWebClientId": "627596102086-5cd89e8da8trtp1mg30s2njsebs9ckkg.apps.googleusercontent.com",
      "firebaseWeb": {
        "apiKey": "AIzaSyAVNL0cq8_7GgUb2_VexbD6mvTXJ-qRwAw",
        "authDomain": "ultimatestudy-16e2f.firebaseapp.com",
        "projectId": "ultimatestudy-16e2f",
        "storageBucket": "ultimatestudy-16e2f.firebasestorage.app",
        "messagingSenderId": "627596102086",
        "appId": "1:627596102086:web:e90dfb6ac466e235860ac7"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "학습지원",
      "shortName": "학습지원",
      "themeColor": "#4F46E5",
      "backgroundColor": "#F4F5FA",
      "favicon": "./assets/icon.png"
    },
    "icon": "./assets/icon.png"
  }
}