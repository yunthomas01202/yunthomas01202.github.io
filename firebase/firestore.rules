rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 각 사용자는 자기 데이터(users/{자기 uid}/...)만 읽고 쓸 수 있어요
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
